\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textcolor {table_green}{Performance and computational efficiency of cross-model communication between Qwen3-8B and Qwen3-14B. Arrows indicate the sender-to-receiver direction. Acc. ($\uparrow $) denotes task accuracy (\%), or pass@1 (\%) for code generation; Dec. ($\downarrow $) denotes the number of explicit vocabulary-decoding operations per problem; and Time ($\downarrow $) denotes end-to-end inference time (seconds per problem). Receiver-only answers the original question without sender representations, using the same receiver generation settings. AVG denotes the unweighted mean across all nine benchmarks. A dash indicates an unavailable result.}}}{5}{table.5}\protected@file@percent }
\newlabel{tab:cross_model_results}{{5}{5}{\xiyan {Performance and computational efficiency of cross-model communication between Qwen3-8B and Qwen3-14B. Arrows indicate the sender-to-receiver direction. Acc. ($\uparrow $) denotes task accuracy (\%), or pass@1 (\%) for code generation; Dec. ($\downarrow $) denotes the number of explicit vocabulary-decoding operations per problem; and Time ($\downarrow $) denotes end-to-end inference time (seconds per problem). Receiver-only answers the original question without sender representations, using the same receiver generation settings. AVG denotes the unweighted mean across all nine benchmarks. A dash indicates an unavailable result.}}{table.5}{}}
